# Tuya Cloud 凭证
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_ENDPOINT=https://openapi.tuyacn.com

# 红外设备 ID（运行发现脚本后填入）
TUYA_INFRARED_ID=
TUYA_REMOTE_ID=

# 学习码（运行 list_learning_codes.py 后填入）
TOY_POWER_CODE=
TOY_PAT_CODE=
TOY_SLOW_CODE=
TOY_FAST_CODE=

# MCP Server
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_PATH=/mcp

# 安全限制
TOY_COMMAND_COOLDOWN_SECONDS=2
TOY_MAX_ROUTINE_SECONDS=120
LOG_LEVEL=INFO
